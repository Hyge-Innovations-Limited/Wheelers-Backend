{
  "name": "@wheleers/mail-service",
  "version": "0.0.1",
  "private": true,
  "description": "Wheelers' own mail service: sends from our own server (signed, queued, retried, paced per provider) and receives (an inbox, bounces, complaints, DMARC reports). No outside mail provider.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wheleers/config": "*",
    "@wheleers/db": "*",
    "html-to-text": "^10.0.1",
    "mailauth": "^8.0.4",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "smtp-server": "^3.21.1"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
