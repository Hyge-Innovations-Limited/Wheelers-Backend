{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "EDIT_TRIP": [
      "PICK_PLACES",
      "REVIEW_TRIP",
      "SET_PRICE",
      "DONE"
    ],
    "PICK_PLACES": [
      "REVIEW_TRIP"
    ],
    "REVIEW_TRIP": [
      "SET_PRICE",
      "DONE"
    ],
    "SET_PRICE": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "EDIT_TRIP",
      "title": "Your trip",
      "terminal": false,
      "data": {
        "pickup": {
          "type": "string",
          "__example__": "University of Lagos, Akoka"
        },
        "stop_1": {
          "type": "string",
          "__example__": ""
        },
        "stop_2": {
          "type": "string",
          "__example__": ""
        },
        "stop_3": {
          "type": "string",
          "__example__": ""
        },
        "destination": {
          "type": "string",
          "__example__": "Yankee by Lustro, Yaba"
        },
        "summary_line": {
          "type": "string",
          "__example__": "2.4 km · ~11 min · suggested fare ₦2,500"
        },
        "has_summary_line": {
          "type": "boolean",
          "__example__": true
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "edit_trip_form",
            "init-values": {
              "pickup": "${data.pickup}",
              "stop_1": "${data.stop_1}",
              "stop_2": "${data.stop_2}",
              "stop_3": "${data.stop_3}",
              "destination": "${data.destination}"
            },
            "children": [
              {
                "type": "TextBody",
                "text": "All correct? Tap Confirm trip. Or change anything first — a name is enough, and you can add up to 3 stops."
              },
              {
                "type": "TextCaption",
                "text": "${data.summary_line}",
                "visible": "${data.has_summary_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "pickup",
                "label": "Pickup",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "stop_1",
                "label": "Stop 1 (optional)",
                "input-type": "text",
                "required": false,
                "helper-text": "A place to pass through. Leave empty for none."
              },
              {
                "type": "TextInput",
                "name": "stop_2",
                "label": "Stop 2 (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "stop_3",
                "label": "Stop 3 (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "destination",
                "label": "Destination",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Confirm trip",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "edit_trip",
                    "pickup": "${form.pickup}",
                    "stop_1": "${form.stop_1}",
                    "stop_2": "${form.stop_2}",
                    "stop_3": "${form.stop_3}",
                    "destination": "${form.destination}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICK_PLACES",
      "title": "Which one?",
      "terminal": false,
      "data": {
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "pickup_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Sabo Market",
              "description": "Yaba, Lagos"
            },
            {
              "id": "none",
              "title": "None of these",
              "description": "Go back and type it again with the area"
            }
          ]
        },
        "show_pickup": {
          "type": "boolean",
          "__example__": false
        },
        "stop_1_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Sabo Market",
              "description": "Yaba, Lagos"
            },
            {
              "id": "none",
              "title": "None of these",
              "description": "Go back and type it again with the area"
            }
          ]
        },
        "show_stop_1": {
          "type": "boolean",
          "__example__": true
        },
        "stop_2_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Sabo Market",
              "description": "Yaba, Lagos"
            },
            {
              "id": "none",
              "title": "None of these",
              "description": "Go back and type it again with the area"
            }
          ]
        },
        "show_stop_2": {
          "type": "boolean",
          "__example__": false
        },
        "stop_3_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Sabo Market",
              "description": "Yaba, Lagos"
            },
            {
              "id": "none",
              "title": "None of these",
              "description": "Go back and type it again with the area"
            }
          ]
        },
        "show_stop_3": {
          "type": "boolean",
          "__example__": false
        },
        "destination_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Sabo Market",
              "description": "Yaba, Lagos"
            },
            {
              "id": "none",
              "title": "None of these",
              "description": "Go back and type it again with the area"
            }
          ]
        },
        "show_destination": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pick_places_form",
            "children": [
              {
                "type": "TextBody",
                "text": "More than one place matched. Pick the right one."
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_pickup",
                "label": "Which pickup?",
                "required": false,
                "data-source": "${data.pickup_options}",
                "visible": "${data.show_pickup}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_stop_1",
                "label": "Which stop 1?",
                "required": false,
                "data-source": "${data.stop_1_options}",
                "visible": "${data.show_stop_1}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_stop_2",
                "label": "Which stop 2?",
                "required": false,
                "data-source": "${data.stop_2_options}",
                "visible": "${data.show_stop_2}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_stop_3",
                "label": "Which stop 3?",
                "required": false,
                "data-source": "${data.stop_3_options}",
                "visible": "${data.show_stop_3}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_destination",
                "label": "Which destination?",
                "required": false,
                "data-source": "${data.destination_options}",
                "visible": "${data.show_destination}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "pick_places",
                    "pick_pickup": "${form.pick_pickup}",
                    "pick_stop_1": "${form.pick_stop_1}",
                    "pick_stop_2": "${form.pick_stop_2}",
                    "pick_stop_3": "${form.pick_stop_3}",
                    "pick_destination": "${form.pick_destination}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REVIEW_TRIP",
      "title": "Your updated trip",
      "terminal": false,
      "data": {
        "pickup_line": {
          "type": "string",
          "__example__": "Pickup: University of Lagos, Akoka"
        },
        "stop_1_line": {
          "type": "string",
          "__example__": "Stop 1: Sabo Market, Yaba"
        },
        "has_stop_1": {
          "type": "boolean",
          "__example__": true
        },
        "stop_2_line": {
          "type": "string",
          "__example__": ""
        },
        "has_stop_2": {
          "type": "boolean",
          "__example__": false
        },
        "stop_3_line": {
          "type": "string",
          "__example__": ""
        },
        "has_stop_3": {
          "type": "boolean",
          "__example__": false
        },
        "destination_line": {
          "type": "string",
          "__example__": "Destination: Yankee by Lustro, Yaba"
        },
        "summary_line": {
          "type": "string",
          "__example__": "3.5 km · ~14 min · suggested fare ₦2,500"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "review_trip_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Is this right?"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextBody",
                "text": "${data.pickup_line}"
              },
              {
                "type": "TextBody",
                "text": "${data.stop_1_line}",
                "visible": "${data.has_stop_1}"
              },
              {
                "type": "TextBody",
                "text": "${data.stop_2_line}",
                "visible": "${data.has_stop_2}"
              },
              {
                "type": "TextBody",
                "text": "${data.stop_3_line}",
                "visible": "${data.has_stop_3}"
              },
              {
                "type": "TextBody",
                "text": "${data.destination_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary_line}"
              },
              {
                "type": "TextCaption",
                "text": "Not right? Tap the arrow at the top to go back and change it."
              },
              {
                "type": "Footer",
                "label": "Confirm trip",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "confirm_trip"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SET_PRICE",
      "title": "Name your price",
      "terminal": false,
      "data": {
        "suggested_price": {
          "type": "string",
          "__example__": "2500"
        },
        "trip_line": {
          "type": "string",
          "__example__": "2.4 km · ~11 min"
        },
        "limits_line": {
          "type": "string",
          "__example__": "Lowest for this trip: ₦2,000 · suggested ₦2,500"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "price_form",
            "init-values": {
              "price": "${data.suggested_price}"
            },
            "children": [
              {
                "type": "TextBody",
                "text": "Trip confirmed. Now name your price. Drivers see it and reply with their own — you only pay when you accept one."
              },
              {
                "type": "TextCaption",
                "text": "${data.trip_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.limits_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "price",
                "label": "Your price (₦)",
                "input-type": "number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Find drivers",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "set_price",
                    "price": "${form.price}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "Wheelers",
      "terminal": true,
      "data": {
        "headline": {
          "type": "string",
          "__example__": "You have successfully bid ₦2,500"
        },
        "note": {
          "type": "string",
          "__example__": "Drivers see your price now. Their offers will come to your chat."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "done_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.headline}"
              },
              {
                "type": "TextBody",
                "text": "${data.note}"
              },
              {
                "type": "Footer",
                "label": "Back to chat",
                "on-click-action": {
                  "name": "complete",
                  "payload": {}
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
