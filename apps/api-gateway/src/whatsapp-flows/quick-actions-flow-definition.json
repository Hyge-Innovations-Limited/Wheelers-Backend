  "screens": [
    {
      "id": "MENU",
      "title": "Quick Actions",
      "terminal": false,
      "data": {
        "greeting_line": {
          "type": "string",
          "__example__": "Hi Timi. What would you like to do?"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "book",
              "title": "Book a ride",
              "description": "Type where you are going"
            },
            {
              "id": "repeat",
              "title": "Repeat last ride",
              "description": "Ikorodu Garage → Shoprite Ikeja"
            },
            {
              "id": "history",
              "title": "Ride history",
              "description": "Places you have been — book any of them again"
            },
            {
              "id": "deposit",
              "title": "Add money",
              "description": "Your account number to transfer to"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "menu_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "${data.greeting_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "choice",
                "label": "Pick one",
                "required": true,
                "data-source": "${data.choices}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "menu_choice",
                    "choice": "${form.choice}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BOOK_WHERE",
      "title": "Book a ride",
      "terminal": false,
      "data": {
        "pickup": {
          "type": "string",
          "__example__": ""
        },
        "destination": {
          "type": "string",
          "__example__": ""
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "book_where_form",
            "init-values": {
              "pickup": "${data.pickup}",
              "destination": "${data.destination}"
            },
            "children": [
              {
                "type": "TextBody",
                "text": "Where are you, and where are you going? A name is enough — you pick the exact place next."
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "pickup",
                "label": "Pickup",
                "input-type": "text",
                "required": true,
                "helper-text": "e.g. Ikeja City Mall"
              },
              {
                "type": "TextInput",
                "name": "destination",
                "label": "Destination",
                "input-type": "text",
                "required": true,
                "helper-text": "e.g. Unilag gate, Yaba"
              },
              {
                "type": "Footer",
                "label": "Find places",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "where_to",
                    "pickup": "${form.pickup}",
                    "destination": "${form.destination}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BOOK_PLACES",
      "title": "Which places?",
      "terminal": false,
      "data": {
        "pickup_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "Ikeja City Mall",
              "description": "Obafemi Awolowo Way, Ikeja, Lagos"
            }
          ]
        },
        "show_pickup": {
          "type": "boolean",
          "__example__": true
        },
        "destination_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "University of Lagos",
              "description": "Akoka, Yaba, Lagos"
            }
          ]
        },
        "show_destination": {
          "type": "boolean",
          "__example__": true
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "book_places_form",
            "children": [
              {
                "type": "TextBody",
                "text": "Here is what I found. Pick the right places."
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_pickup",
                "label": "Pickup",
                "required": false,
                "data-source": "${data.pickup_options}",
                "visible": "${data.show_pickup}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "pick_destination",
                "label": "Destination",
                "required": false,
                "data-source": "${data.destination_options}",
                "visible": "${data.show_destination}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "book_places",
                    "pick_pickup": "${form.pick_pickup}",
                    "pick_destination": "${form.pick_destination}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BOOK_TRIP",
      "title": "Your trip",
      "terminal": false,
