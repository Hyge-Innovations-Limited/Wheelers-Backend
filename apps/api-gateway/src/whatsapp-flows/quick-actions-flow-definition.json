{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "MENU": [
      "BOOK_WHERE",
      "HISTORY",
      "TRIP",
      "REVIEW_TRIP",
      "SET_PRICE",
      "STATUS",
      "OFFERS",
      "ADD_MONEY",
      "SUPPORT",
      "DONE"
    ],
    "BOOK_WHERE": [
      "BOOK_PLACES",
      "DONE"
    ],
    "BOOK_PLACES": [
      "BOOK_TRIP",
      "DONE"
    ],
    "BOOK_TRIP": [
      "BOOK_STOP_PLACES",
      "BOOK_REVIEW",
      "SET_PRICE",
      "DONE"
    ],
    "BOOK_STOP_PLACES": [
      "BOOK_REVIEW",
      "DONE"
    ],
    "BOOK_REVIEW": [
      "SET_PRICE",
      "DONE"
    ],
    "HISTORY": [
      "TRIP",
      "DONE"
    ],
    "TRIP": [
      "REVIEW_TRIP",
      "DONE"
    ],
