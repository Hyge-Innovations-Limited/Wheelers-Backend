        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "book_trip_form",
            "init-values": {
              "stop_1": "${data.stop_1}",
              "stop_2": "${data.stop_2}",
              "stop_3": "${data.stop_3}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.pickup_line}"
              },
              {
                "type": "TextBody",
                "text": "${data.destination_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.summary_line}"
              },
              {
                "type": "TextBody",
                "text": "Stops on the way? Up to three, optional. Then Confirm trip to name your price."
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "stop_1",
                "label": "Stop 1 (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "stop_2",
                "label": "Stop 2 (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "stop_3",
                "label": "Stop 3 (optional)",
                "input-type": "text",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Confirm trip",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "book_trip",
                    "stop_1": "${form.stop_1}",
                    "stop_2": "${form.stop_2}",
                    "stop_3": "${form.stop_3}"
                  }
                }
              }
            ]
          }
        ]
      }
