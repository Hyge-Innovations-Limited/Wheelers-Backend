    "OFFERS": [
      "CHANGE_PRICE",
      "CANCEL_SEARCH",
      "DONE"
    ],
    "CHANGE_PRICE": [
      "DONE"
    ],
    "CANCEL_SEARCH": [
      "DONE"
    ],
    "ADD_MONEY": [],
    "SUPPORT": [],
    "DONE": []
