          "type": "string",
          "__example__": "Destination: University of Lagos, Akoka, Yaba"
        },
        "summary_line": {
          "type": "string",
          "__example__": "12.4 km · ~38 min · suggested fare ₦5,200"
        },
        "stop_1": {
          "type": "string",
          "__example__": ""
        },
        "stop_2": {
          "type": "string",
          "__example__": ""
        },
        "stop_3": {
          "type": "string",
