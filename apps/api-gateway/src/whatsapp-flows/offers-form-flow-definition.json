{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "OFFERS": [
      "CHANGE_PRICE",
      "CANCEL_SEARCH",
      "DONE"
    ],
    "CHANGE_PRICE": [
      "DONE"
    ],
    "CANCEL_SEARCH": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "OFFERS",
      "title": "Driver offers",
      "terminal": false,
      "data": {
        "route_line": {
          "type": "string",
          "__example__": "Itamaga Bus Stop → 15 Aiyetoro Street, Akoka"
        },
        "offer_line": {
          "type": "string",
          "__example__": "Your price: ₦17,000"
        },
        "count_line": {
          "type": "string",
          "__example__": "1 driver has made an offer"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "offer:17000:bid-1",
              "title": "₦17,000 · oke oyebade",
              "description": "Camry · LAG-CAMRY · 5.0★ · 1 min away"
            },
            {
              "id": "change_price",
              "title": "Change my price",
              "description": "Offer drivers a different amount"
            },
            {
              "id": "decline_all",
              "title": "Decline all",
              "description": "None of these drivers — keep searching"
            },
            {
              "id": "cancel_search",
              "title": "Cancel search",
              "description": "Stop looking. Nothing is charged."
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "offers_form",
            "children": [
              {
                "type": "TextCaption",
                "text": "${data.route_line}"
              },
              {
                "type": "TextSubheading",
                "text": "${data.offer_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.count_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "choice",
                "label": "Pick a driver — or something else",
                "required": true,
                "data-source": "${data.choices}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "offers_choice",
                    "choice": "${form.choice}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CHANGE_PRICE",
      "title": "Change my price",
      "terminal": false,
      "data": {
        "current_price": {
          "type": "string",
          "__example__": "17000"
        },
        "offer_line": {
          "type": "string",
          "__example__": "Your price now: ₦17,000"
        },
        "limits_line": {
          "type": "string",
          "__example__": "Lowest for this trip: ₦9,120 · suggested ₦11,400"
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "price_form",
            "init-values": {
              "new_price": "${data.current_price}"
            },
            "children": [
              {
                "type": "TextSubheading",
                "text": "${data.offer_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.limits_line}"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "TextInput",
                "name": "new_price",
                "label": "New price (₦)",
                "input-type": "number",
                "required": true,
                "helper-text": "Every driver looking at your request sees it."
              },
              {
                "type": "Footer",
                "label": "Update price",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "update_price",
                    "new_price": "${form.new_price}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CANCEL_SEARCH",
      "title": "Cancel search",
      "terminal": false,
      "data": {
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Long waiting time"
            },
            {
              "id": "2",
              "title": "Wrong pickup or destination"
            }
          ]
        },
        "error": {
          "type": "string",
          "__example__": ""
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "cancel_form",
            "children": [
              {
                "type": "TextBody",
                "text": "Nothing has been charged. Why are you cancelling?"
              },
              {
                "type": "TextCaption",
                "text": "${data.error}",
                "visible": "${data.has_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "reason",
                "label": "Reason",
                "required": true,
                "data-source": "${data.reasons}"
              },
              {
                "type": "Footer",
                "label": "Cancel search",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "action": "cancel_search",
                    "reason": "${form.reason}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "Wheelers",
      "terminal": true,
      "data": {
        "headline": {
          "type": "string",
          "__example__": "Bid updated"
        },
        "note": {
          "type": "string",
          "__example__": "Drivers can see your new price. Their offers will come to your chat."
        },
        "rearm": {
          "type": "string",
          "__example__": "true"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "done_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.headline}"
              },
              {
                "type": "TextBody",
                "text": "${data.note}"
              },
              {
                "type": "Footer",
                "label": "Back to chat",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "flow": "offers",
                    "rearm": "${data.rearm}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
