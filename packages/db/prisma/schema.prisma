generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(uuid())
  privyDid                   String                      @unique
  username                   String?                     @unique
  passwordHash               String?
  role                       UserRole                    @default(RIDER)
  name                       String?
  phone                      String?
  photoUrl                   String?
  email                      String?
  providerCustomerId         String?                     @unique
  /// Wallet PIN (4 digits) — scrypt hash, never the PIN. Required to withdraw.
  walletPinHash              String?
  walletPinSetAt             DateTime?
  /// Consecutive wrong PINs. Lives on the account, so a fresh link cannot reset it.
  walletPinFailedAttempts    Int                         @default(0)
  walletPinLockedUntil       DateTime?
  /// No withdrawal before this moment (24h after an unverified PIN reset, or a
  /// freeze the user or support asked for).
  withdrawalsFrozenUntil     DateTime?
  withdrawalsFrozenReason    String?
  /// After an unverified reset: until this moment money may only go to a bank
  /// account this user has already withdrawn to.
  withdrawalsRestrictedUntil DateTime?
  /// Only ever receives PIN-reset codes. Never signs anyone in, so it is
  /// separate from `email` and carries no uniqueness rule.
  recoveryEmail              String?
  recoveryEmailVerifiedAt    DateTime?
  /// WhatsApp riders are asked once, before anything else, to accept the
  /// privacy policy. Until AGREED nothing about them goes to a third party
  /// (no bank account is opened) and the bot books nothing.
  privacyConsent             PrivacyConsent              @default(PENDING)
  privacyConsentAt           DateTime?
  bvn                        String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  driver                     Driver?
  notifications              Notification[]
  notificationDevices        NotificationDevice[]
  consents                   UserConsent[]
  wallet                     Wallet?
  virtualAccount             VirtualAccount?
  walletReservations         WalletReservation[]
  withdrawalRequests         WithdrawalRequest[]
  groupRideMatchRequests     GroupRideMatchRequest[]
  groupRideFaceVerifications GroupRideFaceVerification[]
  referralCode               ReferralCode?
  referralsMade              Referral[]                  @relation("ReferralReferrer")
  referralReceived           Referral?                   @relation("ReferralReferred")
  referralCashbacks          ReferralCashback[]
  riderKycStatus             RiderKycStatus              @default(NONE)
  /// Two-sided reputation: drivers see who they're bidding for.
  riderRating                Float                       @default(5.0)
  riderRatingCount           Int                         @default(0)
  selfieCid                  String?
  kycVerifiedAt              DateTime?
  riderKycAttempts           RiderKycAttempt[]
  interstateBookings         InterstateBooking[]
  safetyAlerts               SafetyAlert[]

  @@index([privyDid])
  @@index([username])
  @@index([email])
  @@index([providerCustomerId])
}

model UserConsent {
  id             String      @id @default(uuid())
  userId         String
  consentType    ConsentType
  consentVersion String
  grantedAt      DateTime    @default(now())
  revokedAt      DateTime?
  user           User        @relation(fields: [userId], references: [id])

  @@unique([userId, consentType, consentVersion])
  @@index([userId])
}

model Driver {
  id                   String                @id @default(uuid())
  userId               String                @unique
  status               DriverStatus          @default(OFFLINE)
  kycStatus            KycStatus             @default(PENDING)
  lat                  Float?
  lng                  Float?
  lastSeenAt           DateTime?
  /// "Nearby ride alerts": a rough position sent while signed in but OFF shift,
  /// only after the driver switched it on. Kept apart from lat/lng/lastSeenAt on
  /// purpose — matching reads those as "this driver is available right now".
  standbyEnabled       Boolean               @default(false)
  standbyConsentAt     DateTime?
  standbyLat           Float?
  standbyLng           Float?
  standbySeenAt        DateTime?
  vehicleMake          String?
  vehicleModel         String?
  vehiclePlate         String?
  vehicleYear          Int?
  licenceCid           String?
  insuranceCid         String?
  selfieHash           String?
  rating               Float                 @default(5.0)
  ratingCount          Int                   @default(0)
  totalRides           Int                   @default(0)
  totalEarningsNgn     Decimal               @default(0) @db.Decimal(18, 2)
  user                 User                  @relation(fields: [userId], references: [id])
  kycSubmission        DriverKycSubmission?
  kycReviews           DriverKycReview[]
  rides                Ride[]                @relation("DriverRides")
  bids                 DriverBid[]           @relation("DriverBids")
  interstateDepartures InterstateDeparture[] @relation("DriverInterstateDepartures")
  locationPoints       DriverLocationPoint[]
  dispatchContacts     DispatchContact[]

  @@index([status])
  @@index([kycStatus])
}

model DriverKycSubmission {
  id               String    @id @default(uuid())
  driverId         String    @unique
  ninImageKey      String?
  licenceImageKey  String?
  selfieKey        String?
  vehicleImageKeys String[]  @default([])
  vehicleMake      String?
  vehicleModel     String?
  vehiclePlate     String?
  vehicleYear      Int?
  status           KycStatus @default(PENDING)
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  rejectedFields   String[]  @default([])
  fieldStatuses    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  driver           Driver    @relation(fields: [driverId], references: [id])

  @@index([status, submittedAt])
}

model DriverKycReview {
  id          String    @id @default(uuid())
  driverId    String
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  outcome     KycStatus
  notes       String?
  driver      Driver    @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balanceNgn   Decimal             @default(0) @db.Decimal(18, 2)
  lockedNgn    Decimal             @default(0) @db.Decimal(18, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  rideHolds    RideHold[]
  transactions Transaction[]
  reservations WalletReservation[]
  withdrawals  WithdrawalRequest[]
  user         User                @relation(fields: [userId], references: [id])
}

model VirtualAccount {
  id                    String   @id @default(uuid())
  userId                String   @unique
  /// Which payment provider issued this account. Rows left over from the
  /// retired Pouch integration say "pouch" and are replaced on next provision.
  provider              String   @default("paystack")
  providerCustomerId    String
  providerAccountId     String   @unique
  bankName              String
  accountNumber         String
  accountName           String
  currency              String   @default("NGN")
  country               String   @default("NG")
  status                String   @default("active")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])

  @@index([providerAccountId])
}

model RideHold {
  id               String         @id @default(uuid())
  rideId           String         @unique
  walletId         String
  riderId          String
  driverUserId     String?
  amountNgn        Decimal        @db.Decimal(18, 2)
  status           RideHoldStatus @default(ACTIVE)
  settledAmountNgn Decimal?       @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  settledAt        DateTime?
  wallet           Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([riderId, status])
}

model Transaction {
  id              String               @id @default(uuid())
  walletId        String
  type            TransactionType
  direction       TransactionDirection
  amountNgn       Decimal              @db.Decimal(18, 2)
  balanceAfterNgn Decimal              @db.Decimal(18, 2)
  referenceId     String
  metadata        Json?
  createdAt       DateTime             @default(now())
  wallet          Wallet               @relation(fields: [walletId], references: [id])

  @@unique([walletId, type, direction, referenceId])
  @@index([walletId, createdAt])
  @@index([referenceId])
}

model WalletReservation {
  id          String                  @id @default(uuid())
  walletId    String
  userId      String
  kind        WalletReservationKind
  status      WalletReservationStatus @default(ACTIVE)
  amountNgn   Decimal                 @db.Decimal(18, 2)
  referenceId String                  @unique
  metadata    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  releasedAt  DateTime?
  consumedAt  DateTime?
  user        User                    @relation(fields: [userId], references: [id])
  wallet      Wallet                  @relation(fields: [walletId], references: [id])
  withdrawal  WithdrawalRequest?

  @@index([walletId, status])
  @@index([userId, status])
}

model WithdrawalRequest {
  id                 String                  @id @default(uuid())
  userId             String
  walletId           String
  reservationId      String                  @unique
  providerPayoutId   String?                 @unique
  providerReference  String?                 @unique
  status             WithdrawalRequestStatus @default(PENDING)
  requestedAmountNgn Decimal                 @db.Decimal(18, 2)
  reservedAmountNgn  Decimal                 @db.Decimal(18, 2)
  bankAccountNumber  String
  bankAccountName    String
  bankNetworkId      String
  /// What the provider charged Wheelers for this transfer, booked against the
  /// platform wallet at settlement.
  providerFeeNgn     Decimal?                @db.Decimal(18, 2)
  failureReason      String?
  providerPayload    Json?
  expiresAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  settledAt          DateTime?
  failedAt           DateTime?
  releasedAt         DateTime?
  user               User                    @relation(fields: [userId], references: [id])
  wallet             Wallet                  @relation(fields: [walletId], references: [id])
  reservation        WalletReservation       @relation(fields: [reservationId], references: [id])

  @@index([userId, status, createdAt])
  @@index([walletId, status, createdAt])
}

model GroupRideMatchRequest {
  id                     String                      @id @default(uuid())
  userId                 String
  status                 GroupRideMatchRequestStatus @default(PENDING_FACE_UPLOAD)
  groupId                String?
  matchedRideIds         Json?
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  genderPreference       GroupRideGenderPreference   @default(ANY)
  stops                  Json?
  plannedDistanceKm      Float?
  plannedDurationSeconds Int?
  fareEstimateNgn        Decimal?                    @db.Decimal(18, 2)
  paymentMethod          ScheduledRidePaymentMethod  @default(WALLET_BALANCE)
  readyForMatchAt        DateTime?
  matchingStartedAt      DateTime?
  groupedAt              DateTime?
  bookedAt               DateTime?
  expiredAt              DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User                        @relation(fields: [userId], references: [id])
  faceVerification       GroupRideFaceVerification?

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([groupId, status, updatedAt])
  @@index([genderPreference, status])
}

model GroupRideFaceVerification {
  id             String                          @id @default(uuid())
  matchRequestId String                          @unique
  userId         String
  bucket         String
  objectKey      String
  mimeType       String
  sizeBytes      Int?
  etag           String?
  uploadStatus   GroupRideFaceVerificationStatus @default(UPLOADING)
  capturedAt     DateTime?
  storedAt       DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  matchRequest   GroupRideMatchRequest           @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  user           User                            @relation(fields: [userId], references: [id])

  @@unique([bucket, objectKey])
  @@index([userId, uploadStatus, createdAt])
}

model Ride {
  id                     String            @id @default(uuid())
  riderId                String
  driverId               String?
  status                 RideStatus        @default(REQUESTED)
  paymentMethod          RidePaymentMethod @default(WALLET)
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  fareEstimateNgn        Decimal?          @db.Decimal(18, 2)
  riderOfferNgn          Decimal?          @db.Decimal(18, 2)
  agreedFareNgn          Decimal?          @db.Decimal(18, 2)
  fareFinalNgn           Decimal?          @db.Decimal(18, 2)
  platformFeeNgn         Decimal?          @db.Decimal(18, 2)
  distanceKm             Float?
  durationSeconds        Int?
  cancelStage            CancelStage?
  cancelReason           String?
  penaltyNgn             Decimal?          @db.Decimal(18, 2)
  recordingId            String?
  matchedAt              DateTime?
  arrivedAt              DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  disputes               Dispute[]
  gpsLogs                GpsLog[]
  driver                 Driver?           @relation("DriverRides", fields: [driverId], references: [id])
  routeStops             RideStop[]
  bids                   DriverBid[]
  referralQualifications Referral[]        @relation("ReferralFirstRide")

  chatMessages ChatMessage[]

  @@index([riderId, createdAt])
  @@index([driverId, status])
  @@index([status])
}

model ChatMessage {
  id         String         @id @default(uuid())
  rideId     String
  senderId   String
  senderRole ChatSenderRole
  content    String
  createdAt  DateTime       @default(now())
  ride       Ride           @relation(fields: [rideId], references: [id])

  @@index([rideId, createdAt])
}

model RideStop {
  id          String         @id @default(uuid())
  rideId      String
  stopOrder   Int
  type        RideStopType   @default(INTERMEDIATE)
  status      RideStopStatus @default(PENDING)
  lat         Float
  lng         Float
  address     String
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ride        Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, stopOrder])
  @@index([rideId, status, stopOrder])
}

/// One driver's offer on one ride. ride-service keeps bids only in memory
/// while the auction runs, so this is the durable record: what the driver
/// bid, when, and how it ended — the driver's "my bids" history.
model DriverBid {
  id           String          @id @default(uuid())
  rideId       String
  driverId     String
  driverUserId String
  riderId      String
  amountNgn    Decimal         @db.Decimal(18, 2)
  etaSeconds   Int
  distanceKm   Float?
  status       DriverBidStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  ride         Ride            @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver       Driver          @relation("DriverBids", fields: [driverId], references: [id])

  @@unique([rideId, driverId])
  @@index([driverId, createdAt])
  @@index([rideId, status])
}

model ScheduledRide {
  id                     String                     @id @default(uuid())
  riderId                String
  status                 ScheduledRideStatus        @default(SCHEDULED)
  paymentMethod          ScheduledRidePaymentMethod @default(WALLET_BALANCE)
  scheduledFor           DateTime
  requestedRideId        String?                    @unique
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  stops                  Json?
  plannedDistanceKm      Float?
  plannedDurationSeconds Int?
  fareEstimateNgn        Decimal?                   @db.Decimal(18, 2)
  cancellationReason     String?
  cancelledAt            DateTime?
  dispatchedAt           DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([riderId, scheduledFor])
  @@index([status, scheduledFor])
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code, isActive])
}

model Referral {
  id                     String                   @id @default(uuid())
  referrerId             String
  referredUserId         String                   @unique
  code                   String
  status                 ReferralStatus           @default(PENDING)
  appliedAt              DateTime                 @default(now())
  expiresAt              DateTime
  closesAt               DateTime
  firstRideId            String?
  qualifiedAt            DateTime?
  settledAt              DateTime?
  usedToUnlockCashbackId String?                  @unique
  unlockedAmountNgn      Decimal?                 @db.Decimal(18, 2)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  referrer               User                     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser           User                     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  firstRide              Ride?                    @relation("ReferralFirstRide", fields: [firstRideId], references: [id])
  usedToUnlockCashback   ReferralCashback?        @relation("ReferralUnlockingReferral", fields: [usedToUnlockCashbackId], references: [id])
  cashbacks              ReferralCashback[]       @relation("ReferralSource")
  unlocks                ReferralCashbackUnlock[]

  @@index([referrerId, status, appliedAt])
  @@index([referredUserId, status])
  @@index([expiresAt, status])
  @@index([closesAt, status])
}

model ReferralCashback {
  id                 String                   @id @default(uuid())
  userId             String
  sourceReferralId   String?
  type               ReferralCashbackType
  amountNgn          Decimal                  @db.Decimal(18, 2)
  remainingAmountNgn Decimal                  @db.Decimal(18, 2)
  status             ReferralCashbackStatus   @default(AVAILABLE)
  freezesAt          DateTime
  frozenAt           DateTime?
  usedAt             DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReferral     Referral?                @relation("ReferralSource", fields: [sourceReferralId], references: [id])
  unlockedByReferral Referral?                @relation("ReferralUnlockingReferral")
  usages             ReferralCashbackUsage[]
  unlocks            ReferralCashbackUnlock[]

  @@index([userId, status, freezesAt])
  @@index([sourceReferralId])
}

model ReferralCashbackUsage {
  id         String                      @id @default(uuid())
  cashbackId String
  rideId     String?
  amountNgn  Decimal                     @db.Decimal(18, 2)
  status     ReferralCashbackUsageStatus @default(RESERVED)
  createdAt  DateTime                    @default(now())
  settledAt  DateTime?
  releasedAt DateTime?
  cashback   ReferralCashback            @relation(fields: [cashbackId], references: [id], onDelete: Cascade)

  @@index([cashbackId])
  @@index([rideId, status])
}

model ReferralCashbackUnlock {
  id         String           @id @default(uuid())
  referralId String
  cashbackId String
  amountNgn  Decimal          @db.Decimal(18, 2)
  createdAt  DateTime         @default(now())
  referral   Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  cashback   ReferralCashback @relation(fields: [cashbackId], references: [id], onDelete: Cascade)

  @@unique([referralId, cashbackId])
  @@index([cashbackId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  topic       String
  key         String?
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
  @@index([createdAt])
}

model GpsLog {
  id        String   @id @default(uuid())
  rideId    String
  lat       Float
  lng       Float
  speedKmh  Float?
  timestamp DateTime
  ride      Ride     @relation(fields: [rideId], references: [id])

  @@index([rideId, timestamp])
}

model Dispute {
  id           String             @id @default(uuid())
  rideId       String
  openedBy     String
  openedByRole String
  againstId    String
  reason       String
  status       DisputeStatus      @default(OPEN)
  resolution   DisputeResolution?
  resolvedBy   String?
  notes        String?
  refundNgn    Decimal?           @db.Decimal(18, 2)
  bonusNgn     Decimal?           @db.Decimal(18, 2)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  ride         Ride               @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@index([openedBy])
  @@index([status])
}

model Feedback {
  id           String   @id @default(uuid())
  rideId       String
  reviewerId   String
  reviewerRole String
  revieweeId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  @@unique([rideId, reviewerId])
  @@index([revieweeId])
}

model Notification {
  id            String               @id @default(uuid())
  userId        String
  title         String
  body          String
  category      NotificationCategory
  referenceId   String?
  referenceType String?
  read          Boolean              @default(false)
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model NotificationDevice {
  id               String    @id @default(uuid())
  userId           String
  expoPushToken    String    @unique
  platform         String?
  deviceName       String?
  appOwnership     String?
  enabled          Boolean   @default(true)
  lastRegisteredAt DateTime  @default(now())
  lastDeliveredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, updatedAt])
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
}

// ─── Enums ───────────────────────────────────────────────────────

enum PrivacyConsent {
  PENDING
  AGREED
  DECLINED
}

enum UserRole {
  RIDER
  DRIVER
  BOTH
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_RIDE
}

enum RideStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CancelStage {
  BEFORE_MATCH
  AFTER_MATCH
  DRIVER_EN_ROUTE
  ACTIVE_TRIP
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionType {
  DEPOSIT
  DRIVER_PAYOUT
  REFUND
  DISPUTE_RESOLUTION
  RIDE_PAYMENT
  PENALTY
  WITHDRAWAL
  PLATFORM_FEE
  /// A payment-provider charge Wheelers absorbed (deposit cut, transfer fee).
  /// Always a DEBIT on the platform wallet — never revenue.
  PROVIDER_FEE
  /// A manual, documented correction to a wallet (e.g. the pre-launch reset).
  /// Never written by the running system — only by an operator script.
  ADJUSTMENT
}

enum WalletReservationKind {
  WITHDRAWAL
}

enum WalletReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum WithdrawalRequestStatus {
  PENDING
  FUNDS_RESERVED
  /// Money set aside, transfer not yet created: the Paystack float could not cover it, or
  /// payouts are manual. Sent by the queue sweep when the float allows, or by an admin.
  QUEUED
  PAYOUT_CREATED
  PROCESSING
  SETTLED
  FAILED
  EXPIRED
  CANCELLED
}

enum GroupRideMatchRequestStatus {
  PENDING_FACE_UPLOAD
  READY_FOR_MATCH
  MATCHING
  GROUPED
  BOOKED
  EXPIRED
  CANCELLED
}

enum GroupRideFaceVerificationStatus {
  UPLOADING
  STORED
  FAILED
}

enum GroupRideGenderPreference {
  ANY
  WOMEN_ONLY
  MEN_ONLY
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  ESCALATED
}

enum DisputeResolution {
  FAVOUR_RIDER
  FAVOUR_DRIVER
  SPLIT
  NO_ACTION
}

enum ConsentType {
  RECORDING
}

enum NotificationCategory {
  RIDE
  PAYMENT
  WALLET
  DISPUTE
  KYC
  SYSTEM
}

enum RideHoldStatus {
  ACTIVE
  RELEASED
  CHARGED
}

enum DriverBidStatus {
  PENDING
  ACCEPTED
  LOST
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum RideStopType {
  INTERMEDIATE
  FINAL
}

enum RideStopStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum ScheduledRideStatus {
  SCHEDULED
  DISPATCHING
  DISPATCHED
  CANCELLED
  EXPIRED
}

enum ScheduledRidePaymentMethod {
  WALLET_BALANCE
}

enum ReferralStatus {
  PENDING
  QUALIFIED_RIDE
  EXPIRED_NO_RIDE
  CLOSED
}

enum ReferralCashbackType {
  RIDE_QUALIFIED
  NO_RIDE_EXPIRED
}

enum ReferralCashbackStatus {
  AVAILABLE
  FROZEN
  USED
  EXPIRED
}

enum ReferralCashbackUsageStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum ChatSenderRole {
  RIDER
  DRIVER
}

enum RidePaymentMethod {
  CASH
  WALLET
}

enum RiderKycStatus {
  NONE
  PENDING
  VERIFIED
}

model RiderKycAttempt {
  id            String         @id @default(uuid())
  userId        String
  status        RiderKycStatus
  selfieKey     String?
  livenessScore Float?
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Platform-wide per-user activity log: one row per user action, fed by a
// Kafka sink (analytics-worker) plus synchronous logActivity calls in the
// api-gateway for actions that never touch Kafka. dedupKey makes at-least-once
// Kafka delivery safe to replay.
/// Durable WhatsApp transcript. The Redis conversation window keeps the last
/// ten turns for a week; this keeps every turn, so the bot can be reminded of
/// what a rider said last month.
model WhatsappMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// What we know about a rider, as subject → predicate → object edges: the
/// rider is the subject, `predicate` is the relation (home, work,
/// frequent_place, prefers_payment, language, called, note …) and `object`
/// the value. Repeats raise `weight`; the highest-weighted edge per predicate
/// is the one we trust.
model UserMemoryFact {
  id          String   @id @default(uuid())
  userId      String
  predicate   String
  object      String
  weight      Int      @default(1)
  source      String   @default("llm")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, predicate, object])
  @@index([userId, predicate])
}

model UserActivityEvent {
  id         String   @id @default(uuid())
  userId     String
  eventType  String
  source     String
  rideId     String?
  metadata   Json?
  dedupKey   String   @unique
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

// ─── Interstate travel ──────────────────────────────────────────────────────
// Long-distance city-to-city journeys. Unlike a city ride these are scheduled
// ahead of time and sold by the seat, so the unit of inventory is a departure
// rather than a driver: riders either buy seats on a shared vehicle or charter
// the whole thing.

model InterstateRoute {
  id              String                @id @default(uuid())
  originState     String
  originCity      String
  originTerminal  String
  originLat       Float
  originLng       Float
  destState       String
  destCity        String
  destTerminal    String
  destLat         Float
  destLng         Float
  distanceKm      Float
  durationMinutes Int
  /// Current list price per seat on a shared vehicle.
  seatPriceNgn    Decimal               @db.Decimal(18, 2)
  /// Current list price to charter a whole vehicle on this route.
  charterPriceNgn Decimal               @db.Decimal(18, 2)
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  departures      InterstateDeparture[]

  @@unique([originCity, destCity])
  @@index([originState, destState, active])
  @@index([active, originCity])
}

model InterstateDeparture {
  id              String                    @id @default(uuid())
  routeId         String
  departureAt     DateTime
  vehicleType     InterstateVehicleType     @default(BUS)
  totalSeats      Int
  seatsBooked     Int                       @default(0)
  /// Prices are snapshotted per departure so a later price change never
  /// rewrites what an existing passenger agreed to pay.
  seatPriceNgn    Decimal                   @db.Decimal(18, 2)
  charterPriceNgn Decimal                   @db.Decimal(18, 2)
  /// A CHARTER departure belongs to one booking and is never sold by the seat.
  bookingMode     InterstateBookingMode     @default(SHARED)
  /// Below this many seats the trip is not economic and gets cancelled.
  minimumSeats    Int                       @default(1)
  status          InterstateDepartureStatus @default(SCHEDULED)
  driverId        String?
  vehiclePlate    String?
  dispatchedAt    DateTime?
  departedAt      DateTime?
  arrivedAt       DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  route           InterstateRoute           @relation(fields: [routeId], references: [id])
  driver          Driver?                   @relation("DriverInterstateDepartures", fields: [driverId], references: [id])
  bookings        InterstateBooking[]

  @@index([routeId, departureAt, status])
  @@index([status, departureAt])
  @@index([driverId, status])
}

model InterstateBooking {
  id             String                  @id @default(uuid())
  departureId    String
  userId         String
  mode           InterstateBookingMode   @default(SHARED)
  seats          Int                     @default(1)
  /// What the rider offered to pay. Equal to `amountNgn` on a booking taken at
  /// the posted price; lower on one still waiting for a driver to accept it.
  offeredNgn     Decimal?                @db.Decimal(18, 2)
  /// The posted price at the time of the offer, so an operator can see how far
  /// below list a rider bid without re-deriving it from a since-changed route.
  listPriceNgn   Decimal?                @db.Decimal(18, 2)
  declineReason  String?
  acceptedAt     DateTime?
  amountNgn      Decimal                 @db.Decimal(18, 2)
  refundedNgn    Decimal?                @db.Decimal(18, 2)
  status         InterstateBookingStatus @default(CONFIRMED)
  /// Riders routinely book on behalf of family, so the traveller is not
  /// necessarily the account holder.
  passengerName  String?
  passengerPhone String?
  pickupNote     String?
  reference      String                  @unique
  cancelledAt    DateTime?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  departure      InterstateDeparture     @relation(fields: [departureId], references: [id])
  user           User                    @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([departureId, status])
}

enum InterstateVehicleType {
  SEDAN
  SUV
  MINIBUS
  BUS
}

enum InterstateBookingMode {
  SHARED
  CHARTER
}

enum InterstateDepartureStatus {
  SCHEDULED
  FILLING
  FULL
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum InterstateBookingStatus {
  /// The rider bid below the posted price. No seats are held and no money has
  /// moved — a driver has to accept it first.
  PENDING_OFFER
  /// A driver looked at the bid and passed on it.
  OFFER_DECLINED
  CONFIRMED
  CANCELLED
  REFUNDED
  COMPLETED
  NO_SHOW
}

/// A rider or driver pressing the emergency button during a trip.
///
/// Written on the way in and never overwritten by the app: only an operator
/// changes `status`. The location is snapshotted at the moment the button was
/// pressed, because where someone was when they panicked is the fact that
/// matters — not where their phone drifted to afterwards.
model SafetyAlert {
  id                    String            @id @default(uuid())
  userId                String
  raisedByRole          SafetyAlertRole
  kind                  SafetyAlertKind   @default(SOS)
  status                SafetyAlertStatus @default(OPEN)
  /// The trip this was raised on. Nullable because an alert must never be lost
  /// to a missing foreign key — a rider in trouble outside a trip still counts.
  rideId                String?
  interstateDepartureId String?
  /// The other party on the trip, captured at press time so the operator can
  /// see who the person was with even after the ride record moves on.
  counterpartUserId     String?
  lat                   Float?
  lng                   Float?
  address               String?
  note                  String?
  acknowledgedAt        DateTime?
  /// The operator who took it, by name. Admins live in their own table, not in
  /// User, so this is a recorded name rather than a foreign key.
  handledBy             String?
  resolvedAt            DateTime?
  resolution            String?
  cancelledAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([rideId])
}

enum SafetyAlertRole {
  RIDER
  DRIVER
}

enum SafetyAlertKind {
  SOS
  UNSAFE_DRIVING
  ROUTE_DEVIATION
  ACCIDENT
  MEDICAL
}

enum SafetyAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

/// Where a driver has been. One row per meaningful move, not per ping, and
/// pruned after LOCATION_HISTORY_DAYS — it powers the admin map's trail and
/// settles "the driver never came" disputes, nothing more.
model DriverLocationPoint {
  id         BigInt   @id @default(autoincrement())
  driverId   String
  lat        Float
  lng        Float
  /// "online" (on shift / on a trip) or "standby" (off shift, alerts on).
  source     String   @default("online")
  recordedAt DateTime @default(now())
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@index([recordedAt])
}

/// An operator reaching out to a driver from the dispatch panel — a phone call
/// or a "ride near you" push — and how it went, so two people do not ring the
/// same driver about the same ride.
model DispatchContact {
  id        String   @id @default(uuid())
  driverId  String
  rideId    String?
  adminName String
  /// "call" | "nudge"
  kind      String
  /// "sent" | "accepted" | "declined" | "no_answer" | "unreachable"
  outcome   String
  note      String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([rideId, createdAt])
}
