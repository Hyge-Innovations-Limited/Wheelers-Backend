NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheelers
KAFKA_BROKERS=localhost:9092
# With a password (production: REDIS_PASSWORD in .env.compose): redis://:<password>@localhost:6379
REDIS_URL=redis://localhost:6379
POSTGRES_DB=wheelers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PORT=3000
AWS_REGION=us-east-1
STELLAR_NETWORK=mainnet
STELLAR_MASTER_WALLET_SECRET_NAME=prod/wheelers/stellar/master-wallet
JWT_SECRET=replace-with-at-least-32-random-characters
PRIVY_APP_ID=replace-me
PRIVY_VERIFICATION_KEY=replace-me
WHATSAPP_GATEWAY_URL=http://localhost:3010
WHATSAPP_GATEWAY_PORT=3010
WHATSAPP_GATEWAY_TOKEN=replace-me
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_CLIENT_ID=wheelers-otp
WHATSAPP_SESSION_PATH=apps/whatsapp-gateway/.wwebjs_auth
WHATSAPP_HEADLESS=true
WHATSAPP_CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Legacy SMS fallback:
# TWILIO_ACCOUNT_SID=replace-me
# TWILIO_AUTH_TOKEN=replace-me
# TWILIO_FROM_NUMBER=+10000000000

POUCH_API_KEY=replace-me
POUCH_BASE_URL=https://api.pouch.finance
POUCH_WEBHOOK_SECRET=replace-me
POUCH_PROVIDER_ID=yellowcard
POUCH_COUNTRY_CODE=NG
POUCH_FIAT_CURRENCY=NGN
POUCH_CRYPTO_CURRENCY=USDC
POUCH_CRYPTO_NETWORK=XLM
POUCH_CHAIN=XLM
POUCH_MASTER_WALLET_ADDRESS=GAXHBPYGQWCRYI7VA7XFCHNWJQGJHKTOIKSDNFMS4VO7RPTQ27OO36UI
POUCH_WALLET_TAG=optional-memo
POUCH_TEST_EMAIL=you@example.com
GOOGLE_MAPS_API_KEY=replace-me
GOOGLE_MAPS_BASE_URL=https://routes.googleapis.com
GROUP_RIDE_FACE_S3_BUCKET=replace-me
GROUP_RIDE_FACE_S3_PREFIX=group-rides/face-verification
GROUP_RIDE_FACE_UPLOAD_URL_TTL_S=900
GROUP_RIDE_PICKUP_RADIUS_KM=1.5
GROUP_RIDE_DESTINATION_RADIUS_KM=6
GROUP_RIDE_BEARING_THRESHOLD_DEG=35
GROUP_RIDE_MAX_CANDIDATES=6
GROUP_RIDE_MAX_SIZE=3
GROUP_RIDE_REQUEST_TTL_S=600
PAYMENT_PROVIDER=pouch
PLATFORM_WALLET_ADDRESS=GAXHBPYGQWCRYI7VA7XFCHNWJQGJHKTOIKSDNFMS4VO7RPTQ27OO36UI

PLATFORM_PRIVATE_KEY=dev
RPC_URL_BASE=http://localhost:8545

# MCP server (apps/mcp-server) — remote MCP endpoint for Claude & co.
MCP_PORT=3020
MCP_PUBLIC_URL=https://mcp.wheelersng.com
MCP_GATEWAY_BASE_URL=http://127.0.0.1:3000
# MCP_GATEWAY_WS_URL=ws://127.0.0.1:3000/ws
MCP_ACCESS_TOKEN_TTL_S=86400
MCP_ALLOW_GATEWAY_TOKENS=true
MCP_CORS_ORIGINS=https://claude.ai,https://claude.com

# Sign-in codes over the Meta WhatsApp Cloud API (uses META_ACCESS_TOKEN + META_PHONE_NUMBER_ID).
# Optional approved AUTHENTICATION template; without it plain text is used (24h window only).
# META_OTP_TEMPLATE_NAME=wheelers_login_code
# META_OTP_TEMPLATE_LANGUAGE=en_US

# ── Verification codes ──────────────────────────────────────────────────────
# Delivery walks a chain, cheapest first, stopping at the first success:
#   meta_whatsapp → twilio_whatsapp → twilio_sms
# Meta is cheapest but only reaches people who messaged us in the last 24h,
# so Twilio SMS is what makes signup work for a brand-new rider.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_FROM_NUMBER=+14155550100
# Optional: Twilio Verify issues AND checks the code itself, so no WhatsApp
# template approval is needed anywhere. Supersedes the two senders above.
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override of the order:
# OTP_CHANNEL_ORDER=meta_whatsapp,twilio_whatsapp,twilio_sms

# Shown to a WhatsApp rider who asks for a person, or gets stuck mid-booking,
# e.g. "+234 906 000 3900" or "help@wheelersng.com". Must NOT be the bot's own
# number. Leave unset to show only the change / start again / cancel buttons.
# SUPPORT_CONTACT=

# Link shown in the WhatsApp privacy-consent question (first message from a
# rider). Defaults to https://wheelersng.com/privacy.
# PRIVACY_POLICY_URL=

# The WhatsApp bot's language model. With GEMINI_API_KEY set, Gemini answers
# and Groq (GROQ_API_KEY) is only the backup; unset, the bot runs on Groq alone.
# Create the key at https://aistudio.google.com/apikey — server .env only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash            # booking requests, chat, photo checks
# GEMINI_INTENT_MODEL=gemini-3.5-flash-lite # the quick "what do they want?" reads

# A WhatsApp form is ON when its id is set here, and off when it is not; nothing else
# switches them. The two original flows (WHATSAPP_FLOW_ID, WHATSAPP_OFFERS_FLOW_ID)
# stay off unless WHATSAPP_LEGACY_FLOWS_ENABLED=true.
# WHATSAPP_LEGACY_FLOWS_ENABLED=false

# The "Edit trip" form (pickup, stops and destination on one screen). `npm run flow:push:edit-trip` creates it on
# Meta and writes the id here. Unset, Edit trip uses the chat's Choose sheet.
# WHATSAPP_EDIT_TRIP_FLOW_ID=
# The offers form: the offers message becomes one message with one button — accept,
# change price, decline all and cancel all happen inside it. `npm run flow:push:offers`.
# WHATSAPP_OFFERS_FORM_FLOW_ID=
# Which bank issues riders' deposit account numbers: wema-bank (default) or
# titan-paystack. Changing it only affects NEW accounts; riders who already have
# one keep it until `scripts/migrate-deposit-bank.mjs` moves them (see docs/payments.md).
# PAYSTACK_DVA_BANK=wema-bank

# The Quick Actions form: the menu is one message with one button, and book, repeat,
# history, the current trip and its offers, add money and support are screens inside
# it. `npm run flow:push:quick-actions`. Unset, the menu is the list picker.
# WHATSAPP_QUICK_ACTIONS_FLOW_ID=

# The bot's own WhatsApp number, digits only (e.g. 2348012345678). Gives the price
# page a "Back to WhatsApp" button; unset, the page just says to close itself.
WHATSAPP_BOT_NUMBER=

# The live-trip map on the rider's tracking page. OpenStreetMap needs no key and
# suits light use; point this at a paid tile service when traffic grows. The
# page's security policy allows images from this host automatically.
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# How hard Gemini "thinks" before answering (low | medium | high; empty = model default).
# GEMINI_THINKING_LEVEL=low

# ── Stellar TESTNET (grant deliverable 3) ─────────────────────────────────
# A testnet mirror of fares, commission, top-ups and driver withdrawals. The
# master seed derives every account's key; only public addresses are stored.
# Make one with: openssl rand -hex 32   (keep it like a password)
# STELLAR_ENABLED=false
# STELLAR_MASTER_SEED=
# STELLAR_NGN_PER_XLM=1000

# The rider's 4-digit trip code must be entered to start a trip. Switch on only
# after drivers have the app update with the keypad.
# TRIP_CODE_REQUIRED=false

# Minutes the trip chat stays open after a trip ends. 0 (default): it closes with the trip.
# TRIP_CHAT_AFTER_TRIP_MINUTES=0

# ── Live call (trip chat works without these) ─────────────────────────────
# Our own STUN/TURN server; see infra/turn/README.md. The secret is the value
# in /etc/coturn/secret on that machine. Calls stay off until this says true.
# LIVE_CALL_ENABLED=false
# TURN_HOST=turn.wheelersng.com
# TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=7200

# The day from which a driver needs their papers in to go online (YYYY-MM-DD).
# Leave unset and papers are asked for and shown, and block nobody.
# DRIVER_PAPERS_REQUIRED_FROM=2026-11-15

# SMS has two providers. This says which goes first; the other is the fallback,
# and one that is not set up is skipped. Switch with: npm run sms use termii
#   SMS_PROVIDER=termii    Termii first, Twilio behind it
#   SMS_PROVIDER=twilio    Twilio first, Termii behind it (the default)
# SMS_PROVIDER=termii
#
# Termii. Check all of it at once with: npm run sms
#   TERMII_API_KEY     Termii dashboard > Settings > API. Never commit the real one.
#   TERMII_SENDER_ID   the sender name exactly as Termii approved it (dashboard > IDs).
#                      Quote it when it has a space.
#   TERMII_BASE_URL    the address the dashboard shows beside the key. Accounts differ:
#                        https://v4.api.termii.com   (newer accounts)
#                        https://v3.api.termii.com   (older accounts; used when unset)
#   TERMII_CHANNEL     the route texts take:
#                        dnd       reaches Do-Not-Disturb numbers; for codes (used when unset).
#                                  Termii may need to switch it on for the account.
#                        generic   cheaper, but DND numbers never get the text.
# TERMII_API_KEY=
# TERMII_SENDER_ID="OE Alert"
# TERMII_BASE_URL=https://v4.api.termii.com
# TERMII_CHANNEL=dnd

# ── Database backups (scripts/backup-db.mjs, nightly by cron) ───────────────
# A bucket of their own and a token that can reach only it: never the app's
# R2_* keys or its storage bucket (the script refuses that bucket).
# BACKUP_R2_ACCOUNT_ID=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=wheelers-backups
# BACKUP_DIR=~/backups

# ── Cloudflare in front ─────────────────────────────────────────────────────
# Set to true ONLY once the server accepts web traffic from Cloudflare alone
# (scripts/cloudflare-firewall.mjs). Before that, anyone can send the
# CF-Connecting-IP header and claim any address.
# TRUST_CLOUDFLARE_IP=true

# ── Where rides are taken ───────────────────────────────────────────────────
# Lagos State only (packages/config/src/service-area.ts): a pickup, stop or
# destination outside it is refused, in the app and on WhatsApp. Interstate
# trips are separate and unaffected. "off" lifts the fence (testing elsewhere).
# SERVICE_AREA=lagos

# ── Passkeys (sign in with Face ID or a fingerprint) ────────────────────────
# The website the passkeys belong to; the app proves it may use it through
# wheelersng.com/.well-known (set up on the website).
# PASSKEY_RP_ID=wheelersng.com
# Where signed answers may come from: the website (iPhones), and the Android
# app by its Play signing key: android:apk-key-hash:<the key's SHA-256 in base64url>.
# PASSKEY_ORIGINS=https://wheelersng.com,android:apk-key-hash:REPLACE_ME

# Prembly (IdentityPass): the paid checks of a driver's licence, plate and
# insurance, run from the admin by owners only. Unset, those checks are off;
# checks done by hand still work. PREMBLY_APP_ID only for older accounts.
PREMBLY_API_KEY=
PREMBLY_APP_ID=
