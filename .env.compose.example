POSTGRES_DB=wheelers
POSTGRES_USER=postgres
# Avoid raw '$' here unless you escape it as '$$' for Docker Compose.
POSTGRES_PASSWORD=change-me
# Redis password. Letters and digits only (it goes inside REDIS_URL): openssl rand -hex 32
# The same value goes in .env as REDIS_URL=redis://:<password>@localhost:6379
REDIS_PASSWORD=
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
